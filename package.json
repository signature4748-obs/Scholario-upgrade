{
  "name": "scholario-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=1400 next dev --webpack -p 3000 2>&1 | tee -a dev.log",
    "build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=3072 next build --webpack && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "bun scripts/db-push-guard.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:audit": "bun prisma/audit-db-integrity.ts",
    "db:reset": "bun scripts/db-reset-guard.ts",
    "db:seed": "bun prisma/seed.ts",
    "db:seed-website-cms": "bun prisma/seed-website-cms.ts",
    "db:seed-roster": "bun prisma/seed-roster-150.ts",
    "db:seed-study-materials": "bun prisma/seed-study-materials.ts",
    "db:seed-learning": "bun prisma/seed-learning.ts",
    "db:seed-dashboard": "bun prisma/seed-student-dashboard.ts",
    "db:seed-teacher-hub": "bun prisma/seed-teacher-hub.ts",
    "db:seed-teacher-academics": "bun prisma/seed-teacher-academics.ts",
    "db:seed-tenant-isolation": "bun prisma/seed-tenant-isolation.ts",
    "db:seed-platform": "bun prisma/seed-platform.ts",
    "seed:demo": "bun prisma/seed-demo.ts",
    "seed:clean": "bun prisma/seed-clean.ts",
    "test": "bun test tests/unit/ tests/integration/ tests/api/ tests/regression/ tests/security/",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "test:api": "bun test tests/api/",
    "test:regression": "bun test tests/regression/",
    "test:security": "bun test tests/security/",
    "test:tenant": "bun test tests/security/tenant-isolation.test.ts tests/security/tenant-isolation-model.test.ts",
    "test:platform": "bun test tests/security/platform-isolation.test.ts",
    "test:e2e": "bun test tests/e2e/",
    "test:all": "bun run test && bun run test:e2e",
    "typecheck": "tsc --noEmit"
  },

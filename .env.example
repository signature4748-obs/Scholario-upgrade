# Scholario-OS environment template
#
# Phase 1 — secrets hygiene. Copy to `.env` for local development and fill
# real values. `.env` is git-ignored; NEVER commit real credentials.
# Production values are injected by the deployment environment (never
# files, never the repo).

# ── Database (Phase 8A: Supabase PostgreSQL via the Supavisor pooler) ──
# SESSION mode (5432) supports everything incl. prepared statements.
# Vercel/CI egress with IPv6 can use the direct URL instead:
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Transaction mode for serverless: :6543 + ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Database environment identity (Phase 8A production locks) ─────────
# development | test | staging | production. 'production' hard-blocks all
# seed scripts, db:reset and db:push; a Supabase URL with this UNSET also
# refuses (fail-safe). The integration/acceptance corpus runs as
# 'development'; declare 'production' only at the real cutover.
DATABASE_ENV=development

# ── Supabase platform (Storage / PostgREST; service key is SERVER-ONLY) ─
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-never-expose-to-browser>

# ── Session transport ──────────────────────────────────────────────────
# Production hard-disables the dev Bearer fallback in code (no env can
# re-enable it). SCHOLARIO_DEV_BEARER=0 additionally turns it off in dev.
#SCHOLARIO_DEV_BEARER=1

# ── File signing (signed URLs for stored documents/media) ─────────────
# 32+ random bytes, base64/hex. Unset in dev → ephemeral per-process key.
# FILE_SIGNING_SECRET=

# ── Payments (Razorpay) ────────────────────────────────────────────────
#RAZORPAY_KEY_ID=
#RAZORPAY_KEY_SECRET=
#RAZORPAY_WEBHOOK_SECRET=
#PAYMENTS_SANDBOX=1
#PAYMENTS_SANDBOX_SECRET=

# ── Payments — PLATFORM billing (school → SCHOLARIO) + gateway vault ───
# (SaaS-HARDENING §7 — the two payment domains are strictly separated.)
#
# PLATFORM_PAYMENT_WEBHOOK_SECRET (SERVER-ONLY):
# HMAC-SHA256 secret for POST /api/webhooks/platform-subscription.
# Signature header: x-scholario-signature = hex(HMAC_SHA256(rawBody)).
# The ONLY path that can activate a subscription from an online payment —
# the browser success response never can. UNSET ⇒ fail-closed: the
# webhook rejects every request (401) and subscription activation runs
# exclusively through the platform-admin offline recording flow.
# Generate: openssl rand -hex 32. Set in the production deployment env
# (Vercel encrypted env) when an online gateway is connected.
#PLATFORM_PAYMENT_WEBHOOK_SECRET=
#
# SCHOOL_GATEWAY_ENC_KEY (SERVER-ONLY):
# AES-256-GCM key material for the per-tenant school payment-gateway
# secrets vault (SchoolPaymentGateway cipher/nonce columns — the
# plaintext keys of a school's OWN payment provider never exist outside
# the encrypted row; reads echo only publicKeyId/status). Canonical
# value; falls back to a sha256 derivation of FILE_SIGNING_SECRET when
# unset (stable across instances); with neither configured an ephemeral
# process key is used (dev-only — stored secrets fail loudly instead of
# silently mis-decrypting). Rotating it invalidates previously stored
# ciphertexts (they surface as decrypt errors, never wrong plaintext).
# Generate: openssl rand -hex 32.
#SCHOOL_GATEWAY_ENC_KEY=

# ── Embedding / preview ────────────────────────────────────────────────
# Production: comma-separated https origins allowed to iframe the app
# (legitimate school-website embedding). Empty → 'self' only.
#SCHOOL_EMBED_ORIGINS=

# ── Seed / test credentials (Phase 8A credential-exposure cleanup) ─────
# Demo & fixture account passwords for the seed pipeline and the test
# harness are ENV-DRIVEN (prisma/seed-credentials.ts is the single source;
# tests/helpers/credentials.ts re-exports it). The login UI no longer
# carries ANY demo credential. Unset → dev-safe defaults (the canonical
# dev/QA corpus). Rotate for any shared environment. NEVER set in the
# production deployment (all seeds hard-refuse NODE_ENV=production and
# DATABASE_ENV=production anyway).
#SEED_DEMO_PASSWORD=
#SEED_SUPERADMIN_PASSWORD=
#SEED_SHOWCASE_PRINCIPAL_PASSWORD=
#SEED_SHOWCASE_TEACHER_PASSWORD=
#SEED_SHOWCASE_STUDENT_PASSWORD=
#SEED_PLATFORM_ROOT_PASSWORD=
#SEED_PLATFORM_OPS_PASSWORD=
#SEED_PLATFORM_ROOT_TOTP=
#SEED_PLATFORM_OPS_TOTP=
#SEED_TENANT_FIXTURE_PASSWORD=

# Phase 2 — account provisioning: dev-only default password for API-created
# accounts (students/teachers/principals) so scripted/QA logins keep working.
# NEVER honored in production (random per-account temp passwords are used).
#SCHOLARIO_DEFAULT_PASSWORD=

# ── Observability (Phase 4) ─────────────────────────────────────────────
# Structured-log verbosity: debug | info | warn | error (default info).
#LOG_LEVEL=info
# Slow-query diagnostic threshold in ms (default 200) — queries at/above
# this emit db_slow_query warn lines (SQL shape only, never bound params).
#DB_SLOW_QUERY_MS=200

# ── Transactional email (Phase 8B-7e — Resend) ──────────────────────────
# Server-side only (src/lib/email). RESEND_API_KEY absent → the DEV
# TRANSPORT is live: sends are recorded as SENT EmailDelivery rows with
# providerMessageId 'dev-log' + an 'email_dev_delivery' structured log
# line (the log IS the delivery; dedupe/idempotency work in dev).
# Production sends activate automatically once the key is configured.
# NEVER expose either value to the browser.
# RESEND_API_KEY: also powers the PlatformAdmin password-reset emails
# (docs/PLATFORM_ACCOUNT_RECOVERY.md) — configure it in the Vercel
# production environment before enabling recovery in production.
#RESEND_API_KEY=
# Verified sender identity, e.g. 'Scholario <no-reply@yourdomain.com>'.
# Unset → 'Scholario <onboarding@resend.dev>' (Resend's sandbox sender).
#EMAIL_FROM=

# ── Platform admin Google sign-in (ACCOUNT-RECOVERY, OPTIONAL) ──────────
# Google OAuth/OIDC for PLATFORM ADMINS ONLY (school login unchanged).
# Server-side secrets — NEVER NEXT_PUBLIC_*, never committed, never sent
# to the browser. Both unset ⇒ Google sign-in is honestly OFF (the login
# page hides the button; /api/platform/auth/google/status → false).
# Google Cloud Console setup (docs/PLATFORM_ACCOUNT_RECOVERY.md §Google):
#   · OAuth client (Web application) → Client ID + Secret below.
#   · Authorized JavaScript origins: the production domain + local dev
#     origin (e.g. https://<your-domain> and http://localhost:3000).
#   · Authorized redirect URIs: exactly
#     https://<your-domain>/api/platform/auth/google/callback (and the
#     local dev equivalent http://localhost:3000/api/platform/auth/google/callback).
#   · Scopes used: openid + email (minimal — no profile, no offline
#     access, no refresh tokens, no Google API calls).
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
# Canonical redirect URI when it cannot be derived from the request
# (e.g. behind the gateway). Unset → derived: <request origin>/api/platform/auth/google/callback
#GOOGLE_OAUTH_REDIRECT_URI=

# ── Realtime transport (Phase 8B-7b) ────────────────────────────────────
# supabase (default when SUPABASE_URL+SUPABASE_ANON_KEY are set) —
#   Supabase Realtime broadcast; clients subscribe with the PUBLIC anon
#   key to HMAC-capability channels issued per tenant+role by
#   /api/realtime/config; the server publishes via the Realtime REST
#   broadcast endpoint with the SERVICE-ROLE key. Vercel-compatible.
# event-stream — DEV-ONLY socket.io mini-service on :3003 (sandbox).
# disabled — no realtime (HTTP polling only; everything still works).
#REALTIME_MODE=supabase
# HMAC secret for capability channel names — server-only, stable across
# instances (Vercel encrypted env). Generate: openssl rand -hex 32.
#REALTIME_CHANNEL_SECRET=

# ── Deployment (Phase 8B) ──────────────────────────────────────────────
# Canonical public origin for metadata/OG URLs. On Vercel the platform
# system envs (VERCEL_PROJECT_PRODUCTION_URL / VERCE_URL) win when this
# is unset; local dev falls back to http://localhost:3000.
#APP_URL=

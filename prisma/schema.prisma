// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  code         String   @unique
  domain       String?
  address      String?
  city         String?
  phone        String?
  email        String?
  themeColor   String   @default("#0f766e")
  accentColor  String   @default("#f59e0b")
  logoUrl      String?
  plan         String   @default("STANDARD")
  status       String   @default("ACTIVE")
  academicYear String?
  board        String   @default("CBSE") // CBSE | UP_BOARD | ICSE | STATE | CUSTOM
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                User[]
  teachers             Teacher[]
  students             Student[]
  classes              Class[]
  subjects             Subject[]
  exams                Exam[]
  fees                 Fee[]
  payments             Payment[]
  attendance           Attendance[]
  attendanceAuditLogs  AttendanceAuditLog[]
  attendanceDrafts     AttendanceDraft[]
  attendanceSetting    AttendanceSetting?
  timetables           Timetable[]
  assignments          Assignment[]
  userPreferences      UserPreference[]
  notifications        Notification[]
  libraryBooks         LibraryBook[]
  drivers              Driver[]
  routes               Route[]
  vehicles             Vehicle[]
  questionBanks        QuestionBank[]
  examPapers           ExamPaper[]
  activityLogs         ActivityLog[]
  messages             Message[]
  events               SchoolEvent[]
  examTypes            ExamTypeConfig[]
  gradeScales          GradeScale[]
  examRules            ExamRule[]
  admitCardConfigs     AdmitCardConfig[]
  reportCardConfigs    ReportCardConfig[]
  homeworks            Homework[]
  homeworkSubmissions  HomeworkSubmission[]
  homeworkAuditLogs    HomeworkAuditLog[]
  homeworkPolicies     HomeworkPolicy[]
  noHomeworkDates      NoHomeworkDate[]
  parentGrievances     ParentGrievance[]
  homeworkSurveys      HomeworkSurvey[]
  subjectAssignments   ClassSubjectAssignment[]
  rooms                Room[]
  masterFeeHeads       MasterFeeHead[]
  feeStructures        FeeStructure[]
  feeHeads             FeeHead[]
  feeStructureVersions FeeStructureVersion[]
  feeTransactions      FeeTransaction[]
  settlements          Settlement[]
  reconciliations      Reconciliation[]
  webhookEvents        WebhookEvent[]
  parentConversations  ParentConversation[]
  parentMessages       ParentMessage[]
  behaviorRecords      BehaviorRecord[]
  behaviorCategories   BehaviorCategory[]
  teacherFollowUps     TeacherFollowUp[]
  messageTemplates     MessageTemplate[]

  // Teacher Workspace v2.15 — curriculum & lesson planning
  curriculumTopics        CurriculumTopic[]
  lessonTopicCompletions  LessonTopicCompletion[]

  // Student Growth v2.16 — points, rules, evaluation runs, settings
  growthEvents      GrowthEvent[]
  growthRules       GrowthRule[]
  growthEvalRuns    GrowthEvalRun[]
  growthSetting     GrowthSetting?

  // Communication Hub — per-user direct-thread state rows
  directThreadStates DirectThreadState[]

  // Phase 2 (3-c V5/V10) — cross-tenant file ownership registry for the
  // local-disk upload store (db/uploads/{teachers,admissions}/…).
  uploadedFiles UploadedFile[]
}

/// Per-user conversation state for DIRECT (Message-row) threads. The
/// Message engine itself is 1:1 and stateless; pin / archive / needs-reply
/// are viewer-owned flags persisted here (one row per user↔counterpart).
model DirectThreadState {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// the viewer who owns this state row
  userId        String
  user          User     @relation("DirectThreadStateOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// the other participant of the thread this state belongs to
  counterpartId String
  counterpart   User     @relation("DirectThreadStateCounterpart", fields: [counterpartId], references: [id], onDelete: Cascade)
  pinned        Boolean  @default(false)
  archived      Boolean  @default(false)
  needsReply    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, counterpartId])
  @@index([schoolId, userId])
}

model User {
  id           String    @id @default(cuid())
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String?
  name         String?
  role         String    @default("STUDENT")
  phone        String?
  avatar       String?
  avatarUrl    String?
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacher            Teacher?
  student            Student?
  driver             Driver?
  sessions           Session[]
  activityLogs       ActivityLog[]
  sentNotifications  Notification[]
  createdAssignments Assignment[]
  sentMessages       Message[]      @relation("MessageSender")
  receivedMessages   Message[]      @relation("MessageRecipient")
  createdEvents      SchoolEvent[]
  createdHomeworks   Homework[]
  notificationReads  NotificationRead[]
  preferences        UserPreference?

  // Teacher Hub (Parent Connect / Behavior) — v2.14
  teacherConversations     ParentConversation[] @relation("ParentConversationTeacher")
  guardianConversations    ParentConversation[] @relation("ParentConversationParent")
  sentParentMessages       ParentMessage[]      @relation("ParentMessageSender")
  recordedBehavior         BehaviorRecord[]     @relation("BehaviorRecordRecorder")
  ownedTeacherFollowUps    TeacherFollowUp[]     @relation("TeacherFollowUpTeacher")

  // Student Growth v2.16 — manual points + corrections (automatic events
  // carry no creating user)
  growthEvents     GrowthEvent[] @relation("GrowthEventCreator")

  // Communication Hub — per-user direct-thread state (pin / archive /
  // needs-reply persist in the DB, never in React state or localStorage)
  ownedDirectThreadStates     DirectThreadState[] @relation("DirectThreadStateOwner")
  counterpartDirectThreadStates DirectThreadState[] @relation("DirectThreadStateCounterpart")

  // IQ3000 Phase 4 — canonical subject-teacher appointments + timetable
  // cells taught by this user (effective permissions derive from these).
  subjectsTaught      ClassSubjectAssignment[] @relation("SubjectTeacher")
  timetableSlotsTaught Timetable[]             @relation("TimetableTeacher")

  // PHASE 3 — directory/bulk-message queries filter (school, role, status).
  @@index([schoolId, role, status])
}

model Teacher {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String?
  department    String?
  qualification String?
  subjects      String?
  createdAt     DateTime @default(now())
}

model Student {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?   @relation(fields: [classId], references: [id])
  rollNo        String?
  admissionNo   String?
  guardianId    String?
  guardianName  String?
  guardianPhone String?
  dob           String?
  gender        String?
  bloodGroup    String?
  address       String?
  /// Canonical admission photograph (data URL) — same image captured at
  /// admission; presented on the profile/ID surfaces where permitted.
  photoDataUrl  String?
  routeId       String?
  route         Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  results             Result[]
  fees                Fee[]
  attendance          Attendance[]
  attendanceAuditLogs AttendanceAuditLog[]
  bookIssues          BookIssue[]
  examMarks           ExamMark[]
  examAttendance      ExamAttendance[]
  seatAssignments     ExamSeatAssignment[]
  resultOutcomes      ExamResultOutcome[]
  homeworkSubmissions HomeworkSubmission[]

  // L2D — Learning Experience 2.0 (student-scoped, always school-scoped too
  // via the parent rows: material/deck/group carry schoolId).
  learningActivities  LearningActivity[]
  learningBookmarks   LearningBookmark[]
  studyTasks          StudyTask[]
  studyGroupMembers   StudyGroupMember[]
  studyGroupQuestions StudyGroupQuestion[]
  flashcardReviews    FlashcardReviewState[]
  materialTargets     StudyMaterialTarget[]

  // Teacher Hub (Parent Connect / Behavior) — v2.14
  parentConversations  ParentConversation[]
  behaviorRecords      BehaviorRecord[]
  teacherFollowUps     TeacherFollowUp[]

  // Student Growth v2.16
  growthEvents     GrowthEvent[]

  // PHASE 3 — business identity uniques: admission numbers are unique
  // per school; roll numbers are unique within a class. NULL bypasses
  // (SQLite uniques treat NULL as distinct) — unassigned numbers stay
  // allowed, duplicates among assigned numbers become impossible.
  @@unique([schoolId, admissionNo])
  @@unique([schoolId, classId, rollNo])
  @@index([schoolId, classId])
  @@index([guardianId])
}

// ─── Room — school-level master facility registry (IQ3000 Phase 1) ──────
//
// Rooms are SCHOOL MASTER DATA, Principal-managed (Settings → School
// Configuration → Facilities, plus the Classes toolbar). One registry per
// school (multi-tenant: School A's rooms never appear for School B).
// Class/section homerooms reference the canonical room via Class.roomId;
// `Class.room` keeps a denormalized display name so legacy readers never
// break. Exam seating / timetable rooms keep their own free-text strings —
// they are point-in-time scheduling snapshots, not homeroom assignments.
model Room {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Room name/number as displayed — unique WITHIN the school.
  name      String
  /// Stable human code (e.g. RM-10A) — informational.
  code      String?
  building  String?
  floor     String?
  capacity  Int?
  /// Classroom | Science Lab | Computer Lab | Library | Auditorium |
  /// Music Room | Art Room | Sports Facility | Staff Room | Other
  type      String   @default("Classroom")
  /// Archived rooms stay queryable (historical records remain valid) but
  /// are excluded from new assignment pickers.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes   Class[]

  @@unique([schoolId, name])
  @@index([schoolId, active])
}

model Class {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  gradeLevel     String?
  section        String?
  stream         String? // Science-PCM | Science-PCB | Science-PCMB | Commerce | Humanities | General
  capacity       Int?     @default(40)
  /// Canonical room assignment (Phase 2 — the relational truth). `room`
  /// below stays as the denormalized DISPLAY NAME, kept in sync by the
  /// assignment API whenever roomId changes (legacy readers untouched).
  roomId         String?
  roomRef        Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Display name of the assigned room (projection of roomId). Historical
  /// values remain readable even after a room is archived.
  room           String?
  classTeacherId String?
  createdAt      DateTime @default(now())

  students           Student[]
  subjects           Subject[] // LEGACY — kept for backward-compat; new code should use subjectAssignments
  exams              Exam[]
  attendance         Attendance[]
  attendanceDrafts   AttendanceDraft[]
  timetables         Timetable[]
  assignments        Assignment[]
  questionBanks      QuestionBank[]
  examClasses        ExamClass[]
  examSubjects       ExamSubjectConfig[]
  examSchedule       ExamScheduleItem[]
  examMarks          ExamMark[]
  homeworks          Homework[]
  subjectAssignments ClassSubjectAssignment[]

  // Teacher Workspace v2.15 — curriculum
  curriculumTopics          CurriculumTopic[]

  // PHASE 3 — one class per (school, name, section); class-teacher
  // lookups are a hot directory query.
  @@unique([schoolId, name, section])
  @@index([schoolId, classTeacherId])
}

model Subject {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String? // LEGACY — kept for backward-compat during migration; will be NULL after canonicalization. New code should use ClassSubjectAssignment.
  class     Class?    @relation(fields: [classId], references: [id])
  name      String
  code      String?
  fullMarks Int?      @default(100)
  passMarks Int?      @default(33)
  // Spec §18: subject lifecycle — Active appears in new exam creation;
  // Archived remains queryable for historical records.
  status    String    @default("Active") // Active | Archived
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  results          Result[]
  timetables       Timetable[]
  assignments      Assignment[]
  questionBanks    QuestionBank[]
  examSubjects     ExamSubjectConfig[]
  examSchedule       ExamScheduleItem[]
  examMarks        ExamMark[]
  homeworks        Homework[]
  examAttendances  ExamAttendance[]
  classAssignments ClassSubjectAssignment[]

  // Teacher Workspace v2.15
  curriculumTopics        CurriculumTopic[]

  // L2D — Learning Experience 2.0 subject-linked entities.
  flashcardDecks   FlashcardDeck[]
  studyTasks       StudyTask[]
  studyGroups      StudyGroup[]

  // Spec §12/§32: stable canonical identity per school — one subject per code.
  // Prevents future duplicate subject creation at the database level.
  @@unique([schoolId, code])
}

// ─── ClassSubjectAssignment (Spec §19/§20) ─────────────────────────────
// Separates the SUBJECT (canonical, school-scoped) from its ASSIGNMENT to
// a specific class (+ optional stream). One canonical "Hindi" subject can
// be assigned to many classes. Removing an assignment does NOT delete the
// canonical subject — historical records remain valid (Spec §16/§25).
model ClassSubjectAssignment {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// The teacher APPOINTED to teach this subject in this class — the
  /// canonical subject-teacher assignment (Phase 4). Teacher's USER id,
  /// matching Class.classTeacherId's convention. Null = vacant slot.
  /// Effective permissions (marks entry, attendance scope, directory
  /// scope) derive from THIS column — never from display strings.
  teacherUserId String?
  teacherUser   User?     @relation("SubjectTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
  // Spec §34: distinguishes core/default subjects from additional/optional ones.
  isCore       Boolean   @default(true)
  // Spec §18/§35: an inactive assignment is excluded from new examinations
  // but historical records remain valid. Archived subjects are not selectable.
  isActive     Boolean   @default(true)
  // Spec §33: some subjects are examinable, others are not (e.g. PE, Music).
  examinable   Boolean   @default(true)
  // Spec §33: deterministic ordering for display.
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  // Spec §12/§19: one assignment per (class, subject) — prevents duplicates.
  @@unique([classId, subjectId])
  // PHASE 3 — the CSA teacher-scope check runs on every marks/attendance
  // authorization; this index is the hottest permission lookup.
  @@index([schoolId, teacherUserId, isActive])
}

model Exam {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  term           String?
  type           String    @default("Unit Test")
  session        String?   @default("2025-2026")
  classId        String?
  class          Class?    @relation(fields: [classId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("Draft")
  resultStatus   String    @default("Not Started")
  passPercentage Float     @default(33)
  declaredAt     DateTime?
  declaredBy     String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  results         Result[]
  examPapers      ExamPaper[]
  examClasses     ExamClass[]
  examSubjects    ExamSubjectConfig[]
  scheduleItems   ExamScheduleItem[]
  marks           ExamMark[]
  auditLogs       ExamAuditLog[]
  examAttendance  ExamAttendance[]
  seatAssignments ExamSeatAssignment[]
  resultOutcomes  ExamResultOutcome[]

  // PHASE 3 — one exam per name per session per school; exam lists are
  // filtered by (school, status, startDate) on every dashboard read.
  @@unique([schoolId, name, session])
  @@index([schoolId, status, startDate])
}

model ExamClass {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([examId, classId])
}

model ExamSubjectConfig {
  id             String   @id @default(cuid())
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  maxMarks       Int      @default(100)
  passMarks      Float    @default(33)
  theoryMarks    Int      @default(100)
  practicalMarks Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([examId, classId, subjectId])
}

model ExamScheduleItem {
  id              String   @id @default(cuid())
  examId          String
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String
  endTime         String
  room            String?
  invigilatorId   String?
  invigilatorName String?
  createdAt       DateTime @default(now())

  examAttendance   ExamAttendance[]
}

model ExamMark {
  id             String    @id @default(cuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId        String
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained  Float?
  status         String    @default("PRESENT")
  workflowStatus String    @default("DRAFT")
  originalMarks  Float?
  graceMarks     Float     @default(0)
  graceReason    String?
  graceBy        String?
  remarks        String?
  enteredBy      String?
  verifiedBy     String?
  lockedBy       String?
  enteredAt      DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([examId, classId, subjectId, studentId])
  // PHASE 3 — roster/analytics/growth read marks by class or student
  // without an examId prefix; the compound unique above cannot serve
  // those (leading column is examId).
  @@index([classId, subjectId])
  @@index([studentId])
}

/// Scan Marks Sheet review draft (TWC-SCAN). OCR pre-review state ONLY —
/// never a marks source of truth. Scoped to school + session + teacher +
/// exam + class + subject; submission flows through the canonical
/// marks-entry save/submit routes and deletes the draft.
model MarksScanDraft {
  id        String    @id @default(cuid())
  schoolId  String
  teacherId String
  examId    String
  classId   String
  subjectId String
  session   String?
  maxMarks  Int
  rowsJson  String
  pagesJson String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([schoolId, teacherId, examId, classId, subjectId])
  @@index([schoolId, teacherId])
}

model ExamAttendance {
  id             String            @id @default(cuid())
  examId         String
  exam           Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  scheduleItemId String?
  scheduleItem   ExamScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  classId        String
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date           DateTime
  status         String            @default("PRESENT") // PRESENT, ABSENT, MEDICAL, EXEMPTED
  remarks        String?
  markedBy       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([examId, studentId, subjectId, date])
}

model ExamSeatAssignment {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId    String
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room       String
  seatNumber Int
  row        Int?
  column     Int?
  createdAt  DateTime @default(now())

  @@unique([examId, classId, studentId])
  @@unique([examId, room, seatNumber])
}

model ExamResultOutcome {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  outcome    String   @default("PROMOTED") // PROMOTED, COMPARTMENT, RETEST, NOT_PROMOTED
  reason     String?
  overrideBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([examId, studentId])
}

model ExamAuditLog {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  action    String
  entity    String?
  entityId  String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

model Result {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks      Float
  totalMarks Float    @default(100)
  grade      String?
  remarks    String?
  createdAt  DateTime @default(now())

  // PHASE 3 — report-card rows are idempotent by business key: a retry
  // of the declare/compute flow can never duplicate a student's subject
  // result.
  @@unique([studentId, examId, subjectId])
  @@index([examId, studentId])
  @@index([studentId])
}

model QuestionBank {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    Subject? @relation(fields: [subjectId], references: [id])
  classId    String?
  class      Class?   @relation(fields: [classId], references: [id])
  question   String
  optionA    String?
  optionB    String?
  optionC    String?
  optionD    String?
  answer     String?
  type       String   @default("MCQ")
  difficulty String   @default("MEDIUM")
  marks      Float    @default(1)
  createdAt  DateTime @default(now())
}

model ExamPaper {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId       String?
  exam         Exam?    @relation(fields: [examId], references: [id])
  title        String
  content      String?
  subjectName  String?
  className    String?
  duration     Int      @default(180)
  totalMarks   Int      @default(100)
  instructions String?
  questions    String?
  createdBy    String?
  createdAt    DateTime @default(now())
}

model Fee {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  paid      Float     @default(0)
  type      String?
  dueDate   DateTime?
  status    String    @default("UNPAID")
  method    String?
  paidDate  DateTime?
  createdAt DateTime  @default(now())

  payments Payment[]

  // PHASE 3 — fee lists are filtered by (school, status) and read per
  // student on every ledger surface.
  @@index([schoolId, status])
  @@index([studentId])
}

model Payment {
  id            String   @id @default(cuid())
  /// PHASE 3 — tenant binding: every financial mirror row is school-owned
  /// (backfilled from Fee.schoolId; writers must set it from the session).
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeId         String?
  fee           Fee?     @relation(fields: [feeId], references: [id], onDelete: SetNull)
  amount        Float
  method        String?
  status        String   @default("SUCCESS")
  /// Gateway transaction reference — UNIQUE so a replayed webhook or a
  /// double-verify can never mint a second mirror row for the same money.
  transactionId String?  @unique
  note          String?
  createdAt     DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([feeId])
}

model Attendance {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  date      DateTime
  status    String
  markedBy  String?
  createdAt DateTime @default(now())

  @@unique([studentId, date], name: "studentId_date")
  // PHASE 3 — attendance reads: class-day sheets (school, class, date)
  // and school-day aggregates (school, date) are the two hottest report
  // queries. The (schoolId, studentId, date) variant adds nothing: the
  // existing unique on (studentId, date) is strictly stronger because
  // Student.id is globally unique (one student row = one school).
  @@index([schoolId, classId, date])
  @@index([schoolId, date])
}

// ─── Class Teacher Hub v2.17 — canonical attendance workflow ────────────
//
// ONE canonical attendance record per CLASS + DATE + STUDENT (the unique
// constraint above). The three models below add the workflow layer the
// role-aware architecture requires — never a second attendance record:
//
//   AttendanceAuditLog — every EDIT of an already-saved status is
//                        journaled (who, when, previous → new, source).
//   AttendanceDraft    — an open, not-yet-submitted sheet (autosave, §19);
//                        explicit Save/Submit writes the canonical rows
//                        and deletes the draft.
//   AttendanceSetting  — per-school workflow policy: whether unsaved
//                        drafts are auto-finalized after the configured
//                        end-of-school-hours boundary.

/// One canonical attendance CHANGE record (spec §18): editing an existing
/// status never silently overwrites — each change is journaled with the
/// previous value, the new value, who changed it and when.
model AttendanceAuditLog {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           DateTime
  /// the status that was replaced (audits only exist for real changes)
  previousStatus String
  /// the status now in force
  newStatus      String
  /// BASELINE (class teacher) | SUBJECT_SESSION (subject teacher) | AUTOSAVE
  source         String
  /// display name of the acting teacher (audit survives staff changes)
  changedBy      String
  /// User.id of the acting teacher (nullable — kept even if the user goes)
  changedById    String?
  createdAt      DateTime @default(now())

  @@index([schoolId, classId, date])
  @@index([studentId, date])
}

/// An open, not-yet-submitted attendance sheet (spec §19 autosave): the
/// teacher's in-progress entries for one class-day, persisted server-side
/// so a crash, a navigation or the end-of-school-hours boundary never
/// loses entered attendance. One draft per class+date; an explicit
/// canonical save deletes it. Auto-finalized after the school's
/// end-of-day boundary when policy allows (AttendanceSetting).
model AttendanceDraft {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date          DateTime
  /// JSON array [{ studentId, status }] — validated against the roster
  /// server-side before every write; the draft may be partial.
  entries       String
  updatedById   String
  updatedByName String
  /// BASELINE (class teacher) | SUBJECT_SESSION (subject teacher)
  source        String   @default("BASELINE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([classId, date])
  @@index([schoolId, classId, date])
}

/// Per-school attendance workflow policy (spec §19): whether an unsaved
/// draft is auto-finalized as the canonical record once the school day
/// ends, and where that boundary sits. Seeded with sensible defaults;
/// editable later via a settings surface.
model AttendanceSetting {
  id               String   @id @default(cuid())
  schoolId         String   @unique
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// auto-finalize unsaved drafts after the end-of-day boundary
  autosaveFinalize Boolean  @default(true)
  /// minutes from midnight school time (IST) — 930 = 15:30
  endOfDayMinutes  Int      @default(930)
  updatedAt        DateTime @updatedAt
}

model Timetable {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  day         String
  period      Int
  startTime   String?
  endTime     String?
  /// Relational teacher reference (Phase 4). Display name stays for
  /// rendering; scope resolution joins on the id where present.
  teacherUserId String?
  teacherUser   User?   @relation("TimetableTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
  teacherName String?
  room        String?
  createdAt   DateTime @default(now())

  // PHASE 3 — timetable conflict prevention AT THE DATABASE LEVEL:
  // one cell per (class, day, period) and one teacher per (day, period)
  // per school. teacherUserId NULL (legacy name-matched cells) bypasses
  // the teacher key — the Postgres plan adds a partial unique index
  // WHERE teacher_user_id IS NOT NULL to close that.
  @@unique([schoolId, classId, day, period])
  @@unique([schoolId, teacherUserId, day, period])
  @@index([schoolId, classId, day])
  @@index([schoolId, teacherUserId, day])
}

model Assignment {
  id          String    @id @default(cuid())

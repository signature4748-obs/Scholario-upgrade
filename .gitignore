# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# RB-1 — study material uploads (server-authorized; never commit user bytes)
db/uploads/
# PIH-4a — repo-root upload/ scratch dir (untracked user pastes); git add -A
# must never commit it.
/upload/
# W2.3B — runtime SQLite files: the dev watcher honors .gitignore, and every
# runtime DB write (sessions, read-receipts, prisma writes) was triggering a
# webpack Fast-Refresh rebuild loop (stale chunks + sluggish navigation).
# Ignored here so the watcher stops tracking live database mutations.
db/*.db
db/*.db-journal
db/*.db-shm
db/*.db-wal
tool-results/

# PHASE 8C — QA screenshot dumps never enter the repo (52MB/304 files removed
# in 8C-C; browser QA evidence stays on the QA machine, not in git)
/qa-shots/

# scratch dirs (Turbopack watcher must ignore these)
tmp-scripts/
.zscripts/
agent-ctx/
keepalive.mjs
keepalive.pid

# Phase 1 secrets hygiene — runtime env and the runtime DB (contains PII)
# must never be committed. History rewrite is a coordinated later step.
.env
.env.*
!.env.example
db/*.db
db/*.db-journal

# Phase 8A ops — logical backup archives (contain password hashes; never commit)
/backups/

# embedded PostgreSQL cluster (mini-services/postgres-db) — local dev only
db/pg/

# local audit workspace (verification scripts — never committed)
.audit-work/
